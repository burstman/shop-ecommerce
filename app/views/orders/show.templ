package orders

import (
	"fmt"
	"shopTemplate/app/models"
	"shopTemplate/app/services"
)

var governorates = []string{
	"Ariana", "Ben Arous", "Béja", "Bizerte", "Gabès", "Gafsa", "Jendouba",
	"Kairouan", "Kasserine", "Kébili", "La Mannouba", "Le Kef", "Mahdia",
	"Médenine", "Monastir", "Nabeul", "Sfax", "Sidi Bouzid", "Siliana",
	"Sousse", "Tataouine", "Tozeur", "Tunis", "Zaghouan",
}

templ Show(order models.Order, mescolisConnected bool) {
	<div class="mb-6">
		<a href="/admin/orders" class="text-indigo-600 hover:text-indigo-900 flex items-center gap-1 mb-4">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
			</svg>
			{ services.GetI18n().T(ctx, "back_to_orders") }
		</a>
		<h1 class="text-2xl font-bold">
			Order Details #{ fmt.Sprint(order.ID) }
			if order.IsTest {
				<span class="ml-2 px-2 py-1 text-xs font-semibold rounded bg-purple-100 text-purple-800">{ services.GetI18n().T(ctx, "test_order") }</span>
			}
		</h1>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<div class="lg:col-span-2 space-y-6">
			<div class="bg-white shadow rounded-lg overflow-hidden">
				<div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
					<h2 class="text-lg font-medium text-gray-900">{ services.GetI18n().T(ctx, "order_items") }</h2>
				</div>
				<ul class="divide-y divide-gray-200">
					for _, item := range order.Items {
						<li class="px-6 py-4 flex items-center">
							<div class="flex-shrink-0 h-16 w-16 rounded-md overflow-hidden bg-gray-100">
								if item.ProductImage != "" {
									<img class="h-full w-full object-cover" src={ item.ProductImage } alt={ item.ProductName }/>
								} else {
									<div class="h-full w-full flex items-center justify-center text-gray-400 text-xs">{ services.GetI18n().T(ctx, "no_image") }</div>
								}
							</div>
							<div class="ml-4 flex-1">
								<div class="flex justify-between text-sm font-medium text-gray-900">
									<h3>{ item.ProductName }</h3>
									<p>${ item.Price.Multiply(item.Quantity).String() }</p>
								</div>
								<p class="mt-1 text-sm text-gray-500">{ services.GetI18n().T(ctx, "qty") } { fmt.Sprint(item.Quantity) } x ${ item.Price.String() }</p>
							</div>
						</li>
					}
				</ul>
				<div class="px-6 py-4 border-t border-gray-200 bg-gray-50">
					<div class="flex justify-between text-lg font-bold text-gray-900">
						<span>{ services.GetI18n().T(ctx, "total") }</span>
						<span>${ order.Total.String() }</span>
					</div>
				</div>
			</div>
		</div>

		<div class="space-y-6">
			<div class="bg-white shadow rounded-lg overflow-hidden">
				<div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
					<h2 class="text-lg font-medium text-gray-900">{ services.GetI18n().T(ctx, "order_status") }</h2>
					<span class={ "px-2 inline-flex text-xs leading-5 font-semibold rounded-full", 
						templ.KV("bg-yellow-100 text-yellow-800", order.Status == "pending"),
						templ.KV("bg-teal-100 text-teal-800", order.Status == "confirmed"),
						templ.KV("bg-blue-100 text-blue-800", order.Status == "shipped"),
						templ.KV("bg-green-100 text-green-800", order.Status == "completed"),
						templ.KV("bg-red-100 text-red-800", order.Status == "cancelled"),
						templ.KV("bg-gray-100 text-gray-800", order.Status == "abandoned"),
				templ.KV("bg-purple-100 text-purple-800", order.Status == "test") }>
						{ order.Status }
					</span>
				</div>
				<div class="p-6 space-y-3">
					if order.Status == "pending" {
<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
						<input type="hidden" name="status" value="confirmed"/>
						<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
							{ services.GetI18n().T(ctx, "confirm_order") }
						</button>
					</form>
					if !mescolisConnected {
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="shipped"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "mark_shipped") }
							</button>
						</form>
					}
					<button 
						type="button" 
						hx-get={ fmt.Sprintf("/admin/orders/%d/cancel", order.ID) }
						hx-target="body"
						hx-swap="beforeend"
						class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer"
					>
						{ services.GetI18n().T(ctx, "cancel_order") }
					</button>
				} else if order.Status == "confirmed" {
					if !mescolisConnected {
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="shipped"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "mark_shipped") }
							</button>
						</form>
					}
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="pending"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "revert_pending") }
							</button>
						</form>
						<button 
							type="button" 
							hx-get={ fmt.Sprintf("/admin/orders/%d/cancel", order.ID) }
							hx-target="body"
							hx-swap="beforeend"
							class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer"
						>
							{ services.GetI18n().T(ctx, "cancel_order") }
						</button>
					} else if order.Status == "shipped" {
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="completed"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "mark_completed") }
							</button>
						</form>
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="pending"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "revert_pending") }
							</button>
						</form>
					} else if order.Status == "abandoned" {
						<form hx-post={ fmt.Sprintf("/admin/orders/%d/status", order.ID) }>
							<input type="hidden" name="status" value="pending"/>
							<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
								{ services.GetI18n().T(ctx, "confirm_order_pending") }
							</button>
						</form>
						<button 
							type="button" 
							hx-get={ fmt.Sprintf("/admin/orders/%d/cancel", order.ID) }
							hx-target="body"
							hx-swap="beforeend"
							class="w-full inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md shadow-sm text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer"
						>
							{ services.GetI18n().T(ctx, "cancel_order") }
						</button>
					}
				</div>
			</div>
		</div>
	</div>

	<div class="mt-8 bg-white shadow rounded-lg overflow-hidden">
		<div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
			<h2 class="text-lg font-medium text-gray-900">{ services.GetI18n().T(ctx, "shipping_info") }</h2>
		</div>
				if order.Status == "pending" || order.Status == "abandoned" || order.Status == "test" {
					<form hx-post={ fmt.Sprintf("/admin/orders/%d/info", order.ID) } class="p-6 space-y-4">
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "first_name") }</label>
								<input type="text" name="firstName" value={ order.FirstName } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
							</div>
							<div>
								<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "last_name") }</label>
								<input type="text" name="lastName" value={ order.LastName } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
							</div>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "email_label") }</label>
							<input type="email" name="email" value={ order.Email } class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "phone_label") }</label>
							<input type="tel" name="phone" value={ order.Phone } pattern="[0-9]{8}" title={ services.GetI18n().T(ctx, "phone_8_digits") } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "address") }</label>
							<input type="text" name="address" value={ order.Address } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
						</div>
						<div class="grid grid-cols-2 gap-4">
							<div>
								<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "governorate") }</label>
								<select name="governorate" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
									<option value="">-- { services.GetI18n().T(ctx, "select") } --</option>
									for _, g := range governorates {
										<option value={ g } selected?={ order.Governorate == g }>{ g }</option>
									}
								</select>
							</div>
							<div>
								<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "city") }</label>
								<input type="text" name="city" value={ order.City } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
							</div>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "location") }</label>
							<input type="text" name="location" value={ order.Location } class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder={ services.GetI18n().T(ctx, "location_placeholder") }/>
						</div>
						<button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer">
							{ services.GetI18n().T(ctx, "save_client_info") }
						</button>
					</form>
				} else {
					<div class="p-6 space-y-4">
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "customer") }</label>
							<p class="mt-1 text-sm text-gray-900">{ order.FirstName } { order.LastName }</p>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "email_label") }</label>
							<p class="mt-1 text-sm text-gray-900">{ order.Email }</p>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "phone_label") }</label>
							<p class="mt-1 text-sm text-gray-900">{ order.Phone }</p>
						</div>
						<div>
							<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "address") }</label>
							<p class="mt-1 text-sm text-gray-900">{ order.Address }, { order.City }</p>
						</div>
					</div>
				}
			</div>
	}