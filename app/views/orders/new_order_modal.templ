package orders

import (
	"fmt"
	"shopTemplate/app/models"
	"shopTemplate/app/services"
)

templ NewOrderModal(products []models.Product) {
	<div id="modal" class="fixed inset-0 bg-gray-500/75 flex items-center justify-center z-50">
		<div class="bg-white rounded-lg shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" @click.away="document.getElementById('modal').remove()">
			<div class="flex justify-between items-center mb-4 px-6 pt-6">
				<h2 class="text-xl font-bold text-gray-900">{ services.GetI18n().T(ctx, "new_order_title") }</h2>
				<button type="button" @click="document.getElementById('modal').remove()" class="text-gray-400 hover:text-gray-600 focus:outline-none text-2xl">&times;</button>
			</div>
			<form method="post" action="/admin/orders" class="px-6 pb-6 space-y-4">
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "first_name") }</label>
						<input type="text" name="firstName" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "last_name") }</label>
						<input type="text" name="lastName" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "phone_label") }</label>
					<input type="tel" name="phone" pattern="[0-9]{8}" title={ services.GetI18n().T(ctx, "phone_8_digits") } required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "email_label") }</label>
					<input type="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "address") }</label>
					<input type="text" name="address" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "governorate") }</label>
						<select name="governorate" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
							<option value="">-- { services.GetI18n().T(ctx, "select") } --</option>
							for _, g := range governorates {
								<option value={ g }>{ g }</option>
							}
						</select>
					</div>
					<div>
						<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "city") }</label>
						<input type="text" name="city" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "location") }</label>
					<input type="text" name="location" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder={ services.GetI18n().T(ctx, "location_placeholder") }/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "product") }</label>
					<select name="productId" id="order-product" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
						<option value="">-- { services.GetI18n().T(ctx, "select") } --</option>
						for _, p := range products {
							<option value={ fmt.Sprintf("%d", p.ID) } data-price={ p.Price.String() } data-promo={ p.PromotionPrice.String() }>{ p.Name }</option>
						}
					</select>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "quantity") }</label>
					<input type="number" name="quantity" id="order-quantity" min="1" value="1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "total") }</label>
					<input type="number" name="total" id="order-total" min="0" step="0.01" value="0" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-500 uppercase tracking-wider">{ services.GetI18n().T(ctx, "status") }</label>
					<div class="mt-2 flex gap-4">
						<label class="inline-flex items-center">
							<input type="radio" name="status" value="pending" checked class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500"/>
							<span class="ml-2 text-sm text-gray-900">{ services.GetI18n().T(ctx, "pending") }</span>
						</label>
						<label class="inline-flex items-center">
							<input type="radio" name="status" value="confirmed" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500"/>
							<span class="ml-2 text-sm text-gray-900">{ services.GetI18n().T(ctx, "confirmed") }</span>
						</label>
					</div>
				</div>
				<div class="flex justify-end gap-3 pt-2">
					<button type="button" @click="document.getElementById('modal').remove()" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition-colors">{ services.GetI18n().T(ctx, "cancel") }</button>
					<button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition-colors cursor-pointer">{ services.GetI18n().T(ctx, "save_order") }</button>
				</div>
			</form>
		</div>
	</div>
	<script>
		(function () {
			var product = document.getElementById('order-product');
			var qty = document.getElementById('order-quantity');
			var total = document.getElementById('order-total');
			if (!product || !qty || !total) return;
			function update() {
				var opt = product.options[product.selectedIndex];
				if (!opt || !opt.value) { total.value = '0'; return; }
				var price = parseFloat(opt.getAttribute('data-promo')) > 0
					? parseFloat(opt.getAttribute('data-promo'))
					: parseFloat(opt.getAttribute('data-price'));
				var q = parseInt(qty.value, 10) || 1;
				total.value = (price * q).toFixed(2);
			}
			product.addEventListener('change', update);
			qty.addEventListener('input', update);
		})();
	</script>
}