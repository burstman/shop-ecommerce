package components

import (
	"fmt"
	"shopTemplate/app/config"
	"shopTemplate/app/models"
	"shopTemplate/app/services"
)

func getTrackingPrice(p models.Product) float64 {
	if p.PromotionPrice > 0 {
		return p.PromotionPrice.ToFloat()
	}
	return p.Price.ToFloat()
}


templ ProductCard(product models.Product, cfg *config.Config) {
	<div
		hx-post={ fmt.Sprintf("/cart/add/%d?redirect=/checkout", product.ID) }
		hx-swap="none"
		onclick={ templ.JSFuncCall("trackInitiateCheckout", product.ID, product.Name, getTrackingPrice(product), cfg.Site.Currency) }
		class="group/card relative cursor-pointer"
	>
		<div class="aspect-[3/4] w-full overflow-hidden rounded-md bg-muted lg:aspect-none lg:h-80 relative transition-opacity duration-300 hover:opacity-90">
			if product.Image != "" {
				<img src={ product.Image } alt={ product.Name } class="h-full w-full object-cover object-center lg:h-full lg:w-full"/>
			} else {
				<div class="flex h-full w-full items-center justify-center bg-gray-100">
					<span class="text-gray-400">{ services.GetI18n().T(ctx, "no_image") }</span>
				</div>
			}
			if product.PromotionPrice > 0 {
				<div class="absolute top-2 left-2 z-20 flex flex-col gap-1">
					<span class="inline-flex items-center rounded bg-red-600 px-2 py-1 text-xs font-bold text-white uppercase tracking-wider w-fit">{ services.GetI18n().T(ctx, "sale") }</span>
					<span class="inline-flex items-center rounded bg-black/80 px-2 py-1 text-[10px] font-bold text-white uppercase tracking-wider w-fit">
						-{ fmt.Sprint(int(100 - (product.PromotionPrice.ToFloat() / product.Price.ToFloat() * 100))) }%
					</span>
				</div>
			}
		</div>
		<div class="mt-4 flex justify-between">
			<div>
				<h3 class="text-lg font-medium text-foreground relative">{ product.Name }</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					for i, cat := range product.Categories {
						if i > 0 {
							{ ", " }
						}
						{ cat.Name }
					}
				</p>
			</div>
			<div class="text-right">
				if product.PromotionPrice > 0 {
					<p class="text-sm text-muted-foreground line-through decoration-red-500/50">{ product.Price.String() } { cfg.Site.Currency }</p>
					<p class="text-lg font-bold text-red-600">{ product.PromotionPrice.String() } { cfg.Site.Currency }</p>
				} else {
					<p class="text-lg font-medium text-foreground">{ product.Price.String() } { cfg.Site.Currency }</p>
				}
			</div>
		</div>
	</div>
}
